# Server configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-key-change-in-prod
SESSION_SECRET=your-session-secret-change-in-prod

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL for redirects after Auth
FRONTEND_URL=http://localhost:3001
# Local Vite proxy target (client development only)
VITE_DEV_API_URL=http://localhost:5000
# Optional comma-separated exact Vercel preview origins (never use wildcards)
ALLOWED_PREVIEW_ORIGINS=

# Transactional email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=OpenNotes <no-reply@opennotes.in>
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Database
DATABASE_URL=file:local.db
